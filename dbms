1)	SELECT DISTINCT p.P_No
FROM PROJECT p
JOIN WORKS_ON w ON p.p_No = w.p_No
JOIN EMPLOYEE e ON w.SSN = e.SSN
WHERE e.Name LIKE '%Scott%'

